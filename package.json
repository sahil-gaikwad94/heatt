{
  "name": "heatt",
  "version": "0.2.0",
  "private": true,
  "description": "Heatt — a thoughtful social network for worthwhile moments of expression and discovery.",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build && node --experimental-strip-types scripts/prerender-public.ts",
    "preview": "vite preview --host 0.0.0.0",
    "check": "tsc -b --pretty false",
    "api:check": "tsc -p apps/api/tsconfig.json --pretty false",
    "test:recommendations": "node --experimental-strip-types scripts/recommendation-check.ts",
    "test:content": "node --experimental-strip-types scripts/content-check.ts",
    "test:e2e": "playwright test",
    "test:blogs": "node --experimental-strip-types scripts/blog-catalog-check.ts",
    "test:contrast": "node --experimental-strip-types scripts/theme-contrast-check.ts",
    "capture:ui": "node scripts/capture-ui.mjs"
  },
  "dependencies": {
    "@hono/zod-validator": "latest",
    "@radix-ui/react-dialog": "^1.1.23",
    "@supabase/supabase-js": "latest",
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "latest",
    "clsx": "^2.1.1",
    "hono": "latest",
    "lucide-react": "^1.47.0",
    "motion": "^13.4.0",
    "react": "latest",
    "react-dom": "latest",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "typescript": "latest",
    "vite": "latest",
    "zod": "latest"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@sparticuz/chromium": "^153.0.0",
    "@types/node": "latest",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0"
  }
}
